{
  "name": "disclosure",
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Accessible, zero-dependency headless disclosure primitive for modern UIs.",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "build:react": "pnpm --filter @zealakit/collapsible-react run build",
    "build:vue": "pnpm --filter @zealakit/collapsible-vue run build",
    "build:svelte": "pnpm --filter @zealakit/collapsible-svelte run build",
    "dev:react": "pnpm --filter @zealakit/collapsible-react-example run dev",
    "dev:vue": "pnpm --filter @zealakit/collapsible-vue-example run dev",
    "dev:svelte": "pnpm --filter @zealakit/collapsible-svelte-example run dev",
    "dev:nextjs": "pnpm --filter @zealakit/collapsible-nextjs-example run dev",
    "test": "pnpm -r --filter './packages/*' run test",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "pnpm -r exec rm -rf dist .svelte-kit && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "^24.19.0",
    "typescript": "^5.9.3"
  }
}
